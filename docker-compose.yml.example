services:
  vpn:
    container_name: vpn
    image: vm75/vpn-sandbox
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun
    ports:
      - 9080:80   # config-server
      - 3128:3128 # http-proxy
      - 1080:1080 # socks-proxy
      - 8112:8112 # deluge
      - 8221:8221 # storm
      - 9117:9117 # jackett
      - "8191:8191"
    volumes:
      - ./volumes/vpn-sandbox:/data
      - ./volumes/downloads:/downloads
    restart: unless-stopped

  flaresolverr:
    # DockerHub mirror flaresolverr/flaresolverr:latest
    image: ghcr.io/flaresolverr/flaresolverr:latest
    container_name: flaresolverr
    environment:
      - LOG_LEVEL=${LOG_LEVEL:-info}
      - LOG_FILE=${LOG_FILE:-none}
      - LOG_HTML=${LOG_HTML:-false}
      - CAPTCHA_SOLVER=${CAPTCHA_SOLVER:-none}
      - TZ=${TIMEZONE}
    network_mode: "service:vpn" # <-- Attaches to the VPN's network
    depends_on:
      - vpn                     # <-- Ensures VPN starts first
    volumes:
      - ./volumes/vpn-sandbox/flaresolverr:/config
    restart: unless-stopped